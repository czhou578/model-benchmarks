{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/serve_dashboard.py",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Serving dashboard at (https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
